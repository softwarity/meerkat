{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "console": {
      "projectType": "application",
      "root": ".",
      "sourceRoot": "src",
      "prefix": "app",
      "i18n": {
        "sourceLocale": {
          "code": "en",
          "subPath": "en"
        },
        "locales": {
          "fr": {
            "translation": "src/locale/messages.fr.xlf",
            "subPath": "fr"
          },
          "es": {
            "translation": "src/locale/messages.es.xlf",
            "subPath": "es"
          },
          "de": {
            "translation": "src/locale/messages.de.xlf",
            "subPath": "de"
          },
          "it": {
            "translation": "src/locale/messages.it.xlf",
            "subPath": "it"
          },
          "pt": {
            "translation": "src/locale/messages.pt.xlf",
            "subPath": "pt"
          },
          "nl": {
            "translation": "src/locale/messages.nl.xlf",
            "subPath": "nl"
          },
          "pl": {
            "translation": "src/locale/messages.pl.xlf",
            "subPath": "pl"
          },
          "ru": {
            "translation": "src/locale/messages.ru.xlf",
            "subPath": "ru"
          },
          "uk": {
            "translation": "src/locale/messages.uk.xlf",
            "subPath": "uk"
          },
          "tr": {
            "translation": "src/locale/messages.tr.xlf",
            "subPath": "tr"
          },
          "ar": {
            "translation": "src/locale/messages.ar.xlf",
            "subPath": "ar"
          },
          "he": {
            "translation": "src/locale/messages.he.xlf",
            "subPath": "he"
          },
          "hi": {
            "translation": "src/locale/messages.hi.xlf",
            "subPath": "hi"
          },
          "zh-Hans": {
            "translation": "src/locale/messages.zh-Hans.xlf",
            "subPath": "zh-Hans"
          },
          "ja": {
            "translation": "src/locale/messages.ja.xlf",
            "subPath": "ja"
          },
          "ko": {
            "translation": "src/locale/messages.ko.xlf",
            "subPath": "ko"
          },
          "vi": {
            "translation": "src/locale/messages.vi.xlf",
            "subPath": "vi"
          },
          "th": {
            "translation": "src/locale/messages.th.xlf",
            "subPath": "th"
          },
          "id": {
            "translation": "src/locale/messages.id.xlf",
            "subPath": "id"
          }
        }
      },
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/console",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": [
              "@angular/localize/init"
            ],
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "src/styles.scss"
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1mb",
                  "maximumError": "2mb"
                }
              ],
              "outputHashing": "all",
              "localize": true
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            "en": {
              "localize": [
                "en"
              ],
              "baseHref": "/en/"
            },
            "fr": {
              "localize": [
                "fr"
              ],
              "baseHref": "/fr/"
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "console:build:production"
            },
            "development": {
              "buildTarget": "console:build:development"
            },
            "en": {
              "buildTarget": "console:build:development,en"
            },
            "fr": {
              "buildTarget": "console:build:development,fr"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
